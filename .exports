#!/bin/bash

# .ssh 
export SSH_PATH="$HOME/.ssh"

# Preferred terminal editor.
export EDITOR="nano"
export VISUAL="nano"

# Keep PATH entries unique.
typeset -U PATH path

# Shared user-installed tools.
path=(
  "$HOME/.local/bin"
  "$HOME/.hunk/bin"
  $path
)

# macOS-only: use GNU Coreutils if Homebrew and coreutils are installed.
if [[ "$OSTYPE" == darwin* ]] && command -v brew >/dev/null 2>&1; then
  coreutils_prefix="$(brew --prefix coreutils 2>/dev/null)"
  [[ -d "$coreutils_prefix/libexec/gnubin" ]] && path=(
    "$coreutils_prefix/libexec/gnubin"
    $path
  )
  unset coreutils_prefix
fi

export PATH
