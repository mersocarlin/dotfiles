#!/bin/bash

# Create a new directory and enter it
function mkd() {
	mkdir -p "$@" && cd "$_";
}

# Determine size of a file or total size of a directory
function fs() {
	if du -b /dev/null > /dev/null 2>&1; then
		local arg=-sbh;
	else
		local arg=-sh;
	fi
	if [[ -n "$@" ]]; then
		du $arg -- "$@";
	else
		du $arg .[^.]* ./*;
	fi;
}

function wipe_docker() {
  echo "-> Removing images"
  wipedockerimages
  echo "-> Removing containers"
  wipedockercontainers
  echo "-> Removing volumes"
  wipedockervolumes
}

##
# Calculate date from today
# Sample usage:
# 	- from_today 7d (7 days from now)
# 	- from_today 7w (7 weeks from now)
# 	- from_today 7m (7 months from now)
# 	- from_today 7y (7 years from now)
##
function from_today() {
	date -j -v+$1 +%Y-%m-%d
}

##
# Compress muted videos by ~90%
# Sample usage:
# 	- compress_video input.mp4 output.mp4
##
function compress_video() {
	ffmpeg -i $1 -vcodec libx264 -crf 28 $2
	rm $1
}

##
# Start a bend dev server that serves from this worktree's local URL.
# Works from the checkout root or any subdir (e.g. inside `legacy-packages`):
# it resolves the checkout root via git. In a worktree (.worktrees/<name>) it
# routes via BEND_WORKTREE=<name>; in the main checkout it serves with no
# routing. If a `legacy-packages` subdir exists, bend runs from there.
#
# `bend serve` was replaced by small commands, so this is setup + dev only.
# Run the watchers in their own panes when you want them:
#   bend ts-watch .        # typechecking
#   bend test . --watch    # tests
function bwt() {
  # Resolve the checkout root so location doesn't affect what we derive.
  local root
  root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "❌ Not inside a git repository." >&2
    return 1
  }

  # BEND_WORKTREE only makes sense in a worktree (.worktrees/<name>). In the
  # main checkout, leave it unset so bend serves the main checkout directly.
  local workspace_name=""
  if [[ "$(basename "$(dirname "$root")")" == ".worktrees" ]]; then
    workspace_name=$(basename "$root")
  fi

  local run_dir="$root"
  if [[ -d "$root/legacy-packages" ]]; then
    run_dir="$root/legacy-packages"
  fi

  # BEND_WORKTREE tells bend to route requests to this worktree instead of the main checkout
  (
    cd "$run_dir" || return 1
    # No package args: bend infers them from the cwd, so this works whether
    # run_dir is a package itself or a container like `legacy-packages`.
    bend setup --update || return 1
    if [[ -n "$workspace_name" ]]; then
      BEND_WORKTREE="$workspace_name" bend dev --update
    else
      bend dev --update
    fi
  )
}

##
# Start an nbd dev server. Run from the checkout root or its `nbd` subdir.
# In a worktree (.worktrees/<name>) it routes via BEND_WORKTREE=<name>;
# in the main checkout it serves the main checkout with no routing.
function nwt() {
  # Resolve the checkout root whether we're at the root or inside the nbd subdir
  local root
  if [[ "$(basename "$PWD")" == "nbd" ]]; then
    root=$(dirname "$PWD")
  else
    root="$PWD"
  fi

  # BEND_WORKTREE tells nbd to route requests to this worktree instead of the main checkout
  local workspace_name=""
  if [[ "$(basename "$(dirname "$root")")" == ".worktrees" ]]; then
    workspace_name=$(basename "$root")
  fi

  # Key off the workspace file, not the dir: a stale `nbd` dir outlives flattening
  local run_dir=""
  if [[ -f "$root/pnpm-workspace.yaml" ]]; then
    run_dir="$root"
  elif [[ -f "$root/nbd/pnpm-workspace.yaml" ]]; then
    run_dir="$root/nbd"
  else
    echo "❌ No pnpm-workspace.yaml in $root or $root/nbd." >&2
    return 1
  fi

  (
    cd "$run_dir" || return 1
    NBD_SKIP_PINS=permissive pnpm install && nbd codegen || return 1
    if [[ -n "$workspace_name" ]]; then
      BEND_WORKTREE="$workspace_name" nbd dev
    else
      nbd dev
    fi
  )
}

##
# Report a pane's foreground state as: <shell_pid> <fg_pgid> <cmdline>
#
# A pane is busy when fg_pgid differs from shell_pid: something other than the
# shell owns the terminal, so typed text would land in that program's stdin
# instead of at a prompt.
##
function _herdr_pane_state() {
  herdr pane process-info --pane "$1" 2>/dev/null | jq -r '
    .result.process_info
    | [ (.shell_pid | tostring),
        (.foreground_process_group_id | tostring),
        (.foreground_processes[0].cmdline // "?") ]
    | @tsv'
}

##
# Stop whatever is running in a Herdr pane, escalating until it lets go.
# Sample usage:
#   - herdr_stop_pane <pane-id> [label]
# Returns 0 once the pane is back at a prompt, 1 if it would not stop.
##
function herdr_stop_pane() {
  local pane_id="$1" label="${2:-$1}"
  local shell_pid fg_pgid cmdline stage i

  IFS=$'\t' read -r shell_pid fg_pgid cmdline < <(_herdr_pane_state "$pane_id")
  [[ -z "$shell_pid" ]] && return 1
  [[ "$shell_pid" == "$fg_pgid" ]] && return 0

  # Name what we're killing: a pane-level interrupt is blunt, so leave a trace.
  echo "→ Stopping in $label: $cmdline"

  # ctrl+c through the terminal first, then signal the foreground process group
  # directly. Poll instead of sleeping blindly — bwt/nwt run their servers in a
  # subshell that needs a moment to unwind after the child dies.
  for stage in int term kill; do
    case "$stage" in
      int)  herdr pane send-keys "$pane_id" ctrl+c >/dev/null 2>&1 ;;
      term) [[ "$fg_pgid" -gt 1 ]] && kill -TERM -"$fg_pgid" 2>/dev/null ;;
      kill) [[ "$fg_pgid" -gt 1 ]] && kill -KILL -"$fg_pgid" 2>/dev/null ;;
    esac

    for i in {1..10}; do
      sleep 0.2
      IFS=$'\t' read -r shell_pid fg_pgid cmdline < <(_herdr_pane_state "$pane_id")
      [[ -z "$shell_pid" ]] && return 1
      [[ "$shell_pid" == "$fg_pgid" ]] && return 0
    done
  done

  return 1
}

##
# Create a new Herdr workspace pre-split into agent / git / dev panes:
# agent on top, git and dev side by side below. The workspace opens in the
# current directory, so it lands wherever you already are.
# Also bound to prefix+alt+n in ~/.config/herdr/config.toml.
# Sample usage:
#   - create_workspace
##
function create_workspace() {
  if ! command -v herdr >/dev/null 2>&1; then
    echo "❌ herdr not found." >&2
    return 1
  fi

  # In a pane, $PWD is the anchor. The keybinding runs this detached with no
  # pane env, so there we fall back to the focused pane's cwd.
  local cwd="$PWD"
  if [[ -z "$HERDR_PANE_ID" ]]; then
    cwd=$(herdr pane current 2>/dev/null | jq -r '.result.pane.cwd // empty')
    [[ -z "$cwd" ]] && cwd="$HOME"
  fi

  local ws root bottom right
  ws=$(herdr workspace create --cwd "$cwd" --label "$(basename "$cwd")" --focus) || {
    echo "❌ Could not create the workspace." >&2
    return 1
  }
  root=$(printf '%s' "$ws" | jq -r '.result.root_pane.pane_id')

  # Wide pane splits right, tall pane splits down: down first, then right.
  bottom=$(herdr pane split "$root" --direction down --ratio 0.5 \
    --cwd "$cwd" --no-focus | jq -r '.result.pane.pane_id')
  right=$(herdr pane split "$bottom" --direction right --ratio 0.5 \
    --cwd "$cwd" --no-focus | jq -r '.result.pane.pane_id')

  herdr pane rename "$root" agent >/dev/null
  herdr pane rename "$bottom" git >/dev/null
  herdr pane rename "$right" dev >/dev/null
}

##
# Close the current Herdr workspace, same as prefix+shift+d. Unlike the
# keybinding there is no confirmation dialog: typing the command is the
# confirmation. All panes die with it, running processes included.
# Sample usage:
#   - close_workspace
##
function close_workspace() {
  if [[ -z "$HERDR_WORKSPACE_ID" ]]; then
    echo "❌ Not inside a Herdr pane." >&2
    return 1
  fi
  herdr workspace close "$HERDR_WORKSPACE_ID" >/dev/null
}

##
# Rename the current Herdr workspace after the repo at <path>. Resolves a
# worktree path (<repo>/.worktrees/<name>) to the repo's own name, so the
# label is the repo, never the worktree.
# Sample usage:
#   - herdr_label_workspace <path>
##
function herdr_label_workspace() {
  [[ -z "$HERDR_WORKSPACE_ID" ]] && return 0

  local ws_label="$1"
  if [[ "$(basename "$(dirname "$ws_label")")" == ".worktrees" ]]; then
    ws_label=$(dirname "$(dirname "$ws_label")")
  fi
  ws_label=$(basename "$ws_label")
  if ! herdr workspace rename "$HERDR_WORKSPACE_ID" "$ws_label" >/dev/null 2>&1; then
    echo "⚠️  Could not rename the Herdr workspace to '$ws_label'." >&2
  fi
}

##
# Point the other panes of the current Herdr workspace at a directory.
# Sample usage:
#   - herdr_sync_cwd                  send the other panes to $PWD
#   - herdr_sync_cwd <path>           send the other panes to <path>
#   - herdr_sync_cwd --stop <path>    stop what's running first, then send them
#
# Herdr has no API to change a pane's directory out of band, so this types
# `cd <path>` at each sibling's prompt. Busy panes are skipped unless --stop
# is passed: use it only when staying put is the worse outcome, e.g. the
# directory they're sitting in is about to be deleted.
##
function herdr_sync_cwd() {
  local stop=""
  if [[ "$1" == "--stop" ]]; then
    stop="yes"
    shift
  fi

  # Herdr exports these into every pane it spawns, so this is also the check
  # for "am I running under Herdr at all" — outside a pane they're unset.
  if [[ -z "$HERDR_PANE_ID" || -z "$HERDR_WORKSPACE_ID" ]]; then
    echo "❌ Not inside a Herdr pane." >&2
    return 1
  fi

  # Resolve to an absolute path: the siblings cd from their own cwd, not ours.
  local target
  target=$(cd "${1:-$PWD}" 2>/dev/null && pwd) || {
    echo "❌ Not a directory: ${1:-$PWD}" >&2
    return 1
  }

  local panes
  panes=$(herdr pane list --workspace "$HERDR_WORKSPACE_ID" 2>/dev/null) || {
    echo "⚠️  Could not reach the Herdr socket API — skipping pane sync." >&2
    return 1
  }

  local pane_id label shell_pid fg_pgid cmdline
  while IFS=$'\t' read -r pane_id label; do
    # Never send ourselves a cd — we're already there.
    [[ -z "$pane_id" || "$pane_id" == "$HERDR_PANE_ID" ]] && continue

    IFS=$'\t' read -r shell_pid fg_pgid cmdline < <(_herdr_pane_state "$pane_id")
    [[ -z "$shell_pid" ]] && continue

    if [[ "$shell_pid" != "$fg_pgid" ]]; then
      if [[ -z "$stop" ]]; then
        echo "⏭  Skipped ${label:-$pane_id} — busy."
        continue
      fi
      if ! herdr_stop_pane "$pane_id" "${label:-$pane_id}"; then
        echo "⚠️  ${label:-$pane_id} would not stop — left in its old directory." >&2
        continue
      fi
    fi

    # Quiet on success — the panes visibly move, so a confirmation line is noise.
    # Anything that goes wrong still speaks up.
    if ! herdr pane run "$pane_id" "cd ${(q)target}" >/dev/null 2>&1; then
      echo "⚠️  Could not update ${label:-$pane_id}." >&2
    fi
  done <<< "$(printf '%s' "$panes" | jq -r '.result.panes[] | [.pane_id, (.label // "")] | @tsv')"
}

##
# True on a work machine (the work toolchain writes ~/.hubspot/shellrc).
# Guards the dvx/hsclaude launch paths so a personal machine that happens to
# have an unrelated binary with the same name never takes the wrapper path.
##
function _is_hs_machine() {
  [[ -e "$HOME/.hubspot/shellrc" ]]
}

##
# Pull the current branch of a checkout from its upstream (what ggpull does,
# spelled out: `git pull origin <current branch>` via the tracking ref).
# Sample usage:
#   - git_pull_current [dir]          defaults to the current directory
# Returns 0 on success or when no upstream is configured, 1 on a failed
# pull, 2 when the pull left merge conflicts behind.
##
function git_pull_current() {
  local dir="${1:-$PWD}"
  local branch upstream
  branch=$(git -C "$dir" rev-parse --abbrev-ref HEAD)
  upstream=$(git -C "$dir" rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null)
  if [[ -z "$upstream" ]]; then
    echo "→ No upstream configured for '$branch', skipping pull."
    return 0
  fi

  echo "→ Pulling latest from $upstream..."

  # On github.com, SSH can pick the wrong identity with multiple keys/accounts
  # (personal repo authing as work account -> "Repository not found"). If the
  # owner matches a `gh` account, pull over HTTPS with its token up front (via
  # env, so it stays out of `ps`) — deterministic auth, no doomed SSH attempt.
  local remote_name remote_url owner token
  remote_name="${upstream%%/*}"
  remote_url=$(git -C "$dir" remote get-url "$remote_name" 2>/dev/null)
  if [[ "$remote_url" == *github.com[:/]* ]] && command -v gh >/dev/null 2>&1; then
    owner=$(printf '%s\n' "$remote_url" | sed -E 's#.*github\.com[:/]([^/]+)/.*#\1#')
    token=$(gh auth token --hostname github.com --user "$owner" 2>/dev/null)
  fi

  local pull_ok=""
  if [[ -n "$token" ]]; then
    echo "→ Authenticating as github.com/$owner via gh token..."
    GH_TOKEN="$token" git -C "$dir" \
      -c "url.https://github.com/.insteadOf=git@github.com:" \
      -c "credential.helper=" \
      -c "credential.helper=!f() { echo username=x-access-token; echo password=\$GH_TOKEN; }; f" \
      pull && pull_ok="ok"
  else
    git -C "$dir" pull && pull_ok="ok"
  fi

  if [[ -z "$pull_ok" ]]; then
    if [[ -f "$(git -C "$dir" rev-parse --absolute-git-dir)/MERGE_HEAD" ]]; then
      return 2
    fi
    return 1
  fi
  return 0
}

##
# Create a new git worktree from the current branch
# Sample usage:
#   - create_worktree                            generated name, launches Claude
#   - create_worktree --name my-feature          use this name instead
#   - create_worktree --agent opencode           launch OpenCode instead
#   - create_worktree --agent codex              launch Codex instead
#   - create_worktree --agent none               don't launch anything
##
function create_worktree() {
  local custom_name="" agent="claude"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)
        if [[ -z "$2" ]]; then
          echo "❌ --name requires a value." >&2
          return 1
        fi
        custom_name="$2"
        shift 2
        ;;
      --agent)
        case "$2" in
          claude|opencode|codex|none) agent="$2"; shift 2 ;;
          *)
            echo "❌ --agent must be claude, opencode, codex, or none (got: ${2:-nothing})." >&2
            return 1
            ;;
        esac
        ;;
      *)
        echo "❌ Unknown option: $1" >&2
        echo "   Usage: create_worktree [--name <name>] [--agent claude|opencode|codex|none]" >&2
        return 1
        ;;
    esac
  done

  # The name doubles as the branch name, so it must be branch-legal.
  if [[ -n "$custom_name" ]] && ! git check-ref-format --branch "$custom_name" >/dev/null 2>&1; then
    echo "❌ '$custom_name' is not a valid branch name." >&2
    return 1
  fi

  local current_branch
  current_branch=$(git rev-parse --abbrev-ref HEAD)
  echo "→ Current branch: $current_branch"

  # A conflicted pull is fatal here: the worktree would branch off a broken
  # state. A plain failure (offline, wrong creds) is not — we can still
  # branch from the current local state.
  git_pull_current
  case $? in
    2)
      echo "❌ Pull left conflicts — resolve them on '$current_branch' first, then re-run."
      return 1
      ;;
    1)
      echo "⚠️  Pull failed (remote unreachable or wrong credentials?) — continuing from local '$current_branch'."
      ;;
  esac

  local ADJECTIVES=(mighty brave bold fierce swift daring valiant savage feral wicked crimson scarlet golden silver jade emerald obsidian crystal blazing frozen electric molten radiant prismatic spectral phantom shadow midnight lunar solar stellar cosmic galactic mystic ancient supreme thunderous)
  local NOUNS=(hulk thor vision wasp falcon panther widow rocket gamora loki mantis nova storm wolverine colossus gambit rogue bishop nightcrawler havok iceman beast jubilee spiderman ironman deadpool thanos ultron magneto mystique cyclops daredevil punisher quicksilver groot drax nebula blade zordon kimberly trini zack aisha andros zhane batman superman flash aquaman cyborg batgirl joker bane darkseid lantern venom carnage kingpin galactus doom goblin juggernaut apocalypse sabretooth hela sinestro brainiac scarecrow doomsday zod luthor deathstroke)

  local name
  if [[ -n "$custom_name" ]]; then
    # A requested name that collides is an error, not a retry — silently
    # landing on a different name would betray what was asked for.
    if git worktree list --porcelain | grep -q "branch refs/heads/$custom_name" || \
       git branch --list "$custom_name" | grep -q .; then
      echo "❌ Name '$custom_name' is already in use as a worktree or branch." >&2
      return 1
    fi
    name="$custom_name"
    echo "→ Using name: $name"
  else
    while true; do
      name="${ADJECTIVES[$RANDOM % ${#ADJECTIVES[@]}]}-${NOUNS[$RANDOM % ${#NOUNS[@]}]}"
      if ! git worktree list --porcelain | grep -q "branch refs/heads/$name" && \
         ! git branch --list "$name" | grep -q .; then
        break
      fi
      echo "→ Name '$name' already in use, trying another..."
    done
    echo "→ Generated name: $name"
  fi

  local repo_root
  repo_root=$(git rev-parse --show-toplevel)
  local worktree_path="$repo_root/.worktrees/$name"

  echo "→ Creating worktree at $worktree_path..."
  if ! git worktree add "$worktree_path" -b "$name"; then
    echo "❌ Failed to create worktree."
    return 1
  fi

  echo ""
  echo "🌿 Worktree ready!"
  echo ""
  echo "  Path:   $worktree_path"
  echo "  Branch: $name"
  echo "  Base:   $current_branch"
  echo ""
  cd "$worktree_path"

  # Under Herdr, bring the workspace's other panes along and label the
  # workspace after the repo. No-op elsewhere.
  if [[ -n "$HERDR_PANE_ID" ]]; then
    herdr_sync_cwd "$worktree_path"
    herdr_label_workspace "$repo_root"
  fi

  # Everything below hands the pane over to an agent, so it has to come last.
  [[ "$agent" == "none" ]] && return 0

  if [[ -n "$CLAUDECODE" ]]; then
    echo "  Already inside Claude — run /hcarlin-worktree-session yourself."
    echo ""
    return 0
  fi

  case "$agent" in
    claude)
      # zsh doesn't expand aliases inside functions, so a bare `claude` here
      # would resolve to the native binary and skip the dvx wrapper that links
      # managed rules and checks work auth. Call hsclaude directly.
      if _is_hs_machine && command -v hsclaude >/dev/null 2>&1; then
        echo "  Starting Claude with /hcarlin-worktree-session..."
        echo ""
        hsclaude /hcarlin-worktree-session --dangerously-skip-permissions
      elif command -v claude >/dev/null 2>&1; then
        echo "  Starting Claude with /hcarlin-worktree-session..."
        echo ""
        command claude /hcarlin-worktree-session --dangerously-skip-permissions
      else
        echo "  Claude not found — run /hcarlin-worktree-session once you're in a session."
        echo ""
      fi
      ;;
    opencode)
      # The dvx wrapper forwards unknown args to opencode, so --auto (skip
      # permission prompts) goes through. The skill still isn't pre-triggered
      # here — leave the reminder on screen.
      if _is_hs_machine && command -v dvx >/dev/null 2>&1; then
        echo "  Starting OpenCode — run /hcarlin-worktree-session once inside."
        echo ""
        dvx opencode --auto
      elif command -v opencode >/dev/null 2>&1; then
        echo "  Starting OpenCode — run /hcarlin-worktree-session once inside."
        echo ""
        command opencode --auto
      else
        echo "  OpenCode not found — run /hcarlin-worktree-session once you're in a session."
        echo ""
      fi
      ;;
    codex)
      # Codex is a native install with no dvx wrapper, and it doesn't read
      # Claude skills, so there's no /hcarlin-worktree-session to pre-trigger.
      if command -v codex >/dev/null 2>&1; then
        echo "  Starting Codex..."
        echo ""
        command codex --sandbox danger-full-access
      else
        echo "  Codex not found."
        echo ""
      fi
      ;;
  esac
}

##
# Delete a git worktree and its branch
# Sample usage:
#   - delete_worktree <name>          delete a named worktree
#   - delete_worktree                 from inside a worktree, delete the current one
##
function delete_worktree() {
  local repo_root
  repo_root=$(git worktree list --porcelain | grep "^worktree" | head -1 | awk '{print $2}')
  if [[ -z "$repo_root" ]]; then
    echo "❌ Not inside a git repository." >&2
    return 1
  fi

  local name="$1"

  # No name passed: infer it from the current worktree directory
  if [[ -z "$name" ]]; then
    local toplevel
    toplevel=$(git rev-parse --show-toplevel 2>/dev/null)
    if [[ "$toplevel" == "$repo_root/.worktrees/"* ]]; then
      name=$(basename "$toplevel")
      echo "→ Inferred worktree from current directory: $name"
    else
      echo "❌ Usage: delete_worktree <name>" >&2
      echo "   (or run with no arg from inside a worktree to delete the current one)" >&2
      return 1
    fi
  fi

  local worktree_path="$repo_root/.worktrees/$name"

  # If we're inside the worktree being deleted, step back to the main repo first
  if [[ "$(pwd)" == "$worktree_path"* ]]; then
    echo "→ Leaving worktree, returning to $repo_root..."
    cd "$repo_root" || return 1
  fi

  if [[ ! -d "$worktree_path" ]]; then
    echo "❌ Worktree not found: $worktree_path" >&2
    return 1
  fi

  local branch
  branch=$(git -C "$repo_root" worktree list --porcelain | awk -v path="$worktree_path" '
    /^worktree / { current = $2 }
    /^branch / && current == path { sub("refs/heads/", "", $2); print $2 }
  ')

  if [[ -z "$branch" ]]; then
    echo "⚠️  Could not detect branch for worktree '$name' — it may be in a detached HEAD state."
    echo "   The worktree directory will still be removed, but no branch will be deleted."
  else
    echo "→ Detected branch: $branch"
  fi

  # Kill any bend dev server started with BEND_WORKTREE=$name (it holds files open
  # in the worktree dir, which otherwise blocks removal). ps xeww shows env vars.
  local bend_pids
  bend_pids=$(ps xeww 2>/dev/null | grep -E "BEND_WORKTREE=$name([[:space:]]|$)" | awk '{print $1}')
  if [[ -n "$bend_pids" ]]; then
    echo "→ Stopping bend dev server for $name (PIDs: $(echo $bend_pids | tr '\n' ' '))..."
    echo "$bend_pids" | xargs kill 2>/dev/null
    sleep 1
  fi

  echo "→ Removing worktree at $worktree_path..."
  git -C "$repo_root" worktree remove --force "$worktree_path" 2>/dev/null || true
  if [[ -d "$worktree_path" ]]; then
    rm -rf "$worktree_path" 2>/dev/null || true
  fi
  git -C "$repo_root" worktree prune

  # The panes are stranded in a directory that no longer exists the moment it's
  # removed, so reclaim them here rather than at the end — a branch deletion
  # failure below returns early and would leave them behind. --stop because
  # staying in a deleted directory is worse than losing whatever was running.
  # The rename drops any session suffix added by hand, e.g.
  # "sidekick-chat (login)" back to "sidekick-chat".
  if [[ -n "$HERDR_PANE_ID" ]]; then
    herdr_sync_cwd --stop "$repo_root"
    herdr_label_workspace "$repo_root"
  fi

  if [[ -n "$branch" ]]; then
    if git -C "$repo_root" branch --list "$branch" | grep -q .; then
      echo "→ Deleting branch $branch..."
      if ! git -C "$repo_root" branch -D "$branch"; then
        echo "❌ Failed to delete branch '$branch'." >&2
        return 1
      fi
    else
      echo "→ Branch $branch already gone, skipping."
    fi
  fi

  if [[ -n "$branch" && "$branch" != "$name" ]]; then
    if git -C "$repo_root" branch --list "$name" | grep -q .; then
      echo "→ Deleting original worktree branch $name..."
      git -C "$repo_root" branch -D "$name"
    fi
  fi

  echo ""
  if [[ -d "$worktree_path" ]]; then
    echo "⚠️  Done, but directory still exists: $worktree_path"
    echo "   Another process may still have files open there."
    echo "   Find it with: lsof +D $worktree_path"
    echo "   Then run: rm -rf $worktree_path"
  else
    echo "✅ Done!"
    echo "  Removed worktree: $worktree_path"
  fi
  [[ -n "$branch" ]] && echo "  Deleted branch:   $branch"

  # The worktree usually got merged remotely before being deleted, so bring
  # the main checkout up to date now that we're back on it. Never fatal:
  # the deletion already happened, this is a courtesy.
  echo ""
  git_pull_current "$repo_root"
  case $? in
    2) echo "⚠️  Pull left conflicts in $repo_root — resolve them manually." ;;
    1) echo "⚠️  Pull failed (remote unreachable or wrong credentials?)." ;;
  esac
}
